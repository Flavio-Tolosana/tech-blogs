# Rutas en el homelab
# Ruta absoluta al repositorio clonado de tech-blogs (la salida se escribe en TECH_BLOGS_DIR/dist/)
TECH_BLOGS_DIR=/ruta/a/tech-blogs

# Imagen en DockerHub (debe coincidir con la que construye la pipeline de DockerHub)
IMAGE_NAME=tu-usuario-dockerhub/tech-blogs

# Tag de la imagen (opcional, por defecto "latest")
IMAGE_TAG=latest

# Zona horaria del contenedor (para fechas/horas de los posts)
TZ=Europe/Madrid

# Nombre del contenedor (opcional)
CONTAINER_NAME=tech-blogs
